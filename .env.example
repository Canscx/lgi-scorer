# AI 模型配置。页面「模型设置」里填的优先级高于这里。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash

# 管理员账号（进后台：上传、确认、评分、导报告）
AUTH_USER=admin
AUTH_PASSWORD=abc123456/

# 客户账号（进轻流程：填信息、传材料、一键评估、看结果）
AUTH_CUSTOMER=customer
AUTH_CUSTOMER_PASSWORD=请改成只有客户知道的口令

# 服务端口。与专精特新站（8787）错开，同机部署时两个站并行。
PORT=8788
DATA_DIR=./data

# 中文字体可选：不填则按 项目根 fonts/ → 系统字体 的顺序自动探测
REPORT_FONT_PATH=
